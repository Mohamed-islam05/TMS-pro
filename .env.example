# Database - SQLite (development) / Switch to PostgreSQL for production
DATABASE_URL="file:./dev.db"

# PostgreSQL (uncomment for production)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tms_pro?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS"

# Upstash Redis (required for rate limiting in production)
# Create a free account at https://upstash.com
# UPSTASH_REDIS_REST_URL="REPLACE_WITH_UPSTASH_REDIS_REST_URL"
# UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_REDIS_REST_TOKEN"

# Resend (required for password reset emails)
# Create a free account at https://resend.com
# RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
# EMAIL_FROM="TMS Pro <noreply@yourdomain.com>"
# Public base URL of the app (used in password reset links/emails)
APP_URL="http://localhost:3000"
