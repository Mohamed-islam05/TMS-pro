# ============================================================
# TMS Pro - Environment variable template
# Copy to .env for local development. NEVER commit real values.
# Labels: [dev] local development only | [prod] production required
#         [server] server-only, keep secret | [cli] CLI/migrations only
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL) — [prod] [server]
# ------------------------------------------------------------
# DATABASE_URL: runtime connection. Use the NEON POOLED connection string on
# Vercel (production + preview). Use your local PostgreSQL for development.
DATABASE_URL="postgresql://user:PASSWORD@pgpool-host/dbname?sslmode=require"

# DIRECT_URL: direct (unpooled) connection used ONLY by Prisma CLI, migrations
# and Prisma Studio. Never used by the running application. [prod] [server] [cli]
DIRECT_URL="postgresql://user:PASSWORD@direct-host/dbname?sslmode=require"

# ------------------------------------------------------------
# Isolated test database (PostgreSQL) — [dev] [server]
# MUST point at a database that is NOT the application database. Vitest refuses
# to run against the same host+database as DATABASE_URL. Default when unset:
# postgresql://postgres:postgres@localhost:5432/tms_test
# Remote targets (e.g. a Neon test branch) require TEST_DATABASE_ALLOW_REMOTE=yes.
# ------------------------------------------------------------
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tms_test"
# TEST_DATABASE_ALLOW_REMOTE="yes"

# ------------------------------------------------------------
# NextAuth.js — [dev] localhost | [prod] real https URL, server state
# ------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://tms-pro-taupe.vercel.app"
# NEXTAUTH_SECRET is required in production: >= 32 chars, random, server-only.
NEXTAUTH_SECRET=""

# Public base URL used in password reset emails. [dev] | [prod]
# Production: APP_URL="https://tms-pro-taupe.vercel.app"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# Rate limiting (Upstash Redis) — [prod] [server]
# Missing in production => logins/resets are blocked (fail closed) and
# src/lib/env.ts refuses to boot. Required only for the rate-limit feature.
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------
# Email (Resend) — [prod] [server]
# Password-reset emails. Missing => emails fail silently and env.ts refuses
# to boot in production. Required only for the email feature.
# ------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""

# ------------------------------------------------------------
# db:bootstrap — [prod] [cli] [server]  (manual bootstrap command only)
# Explicit, idempotent bootstrap of the initial Entreprise + ENTREPRISE_ADMIN.
# Requires BOOTSTRAP_CONFIRM=yes. Password is never logged or stored in code.
# ------------------------------------------------------------
# BOOTSTRAP_ADMIN_EMAIL="admin@entreprise.com"
# BOOTSTRAP_ADMIN_PASSWORD=""
# BOOTSTRAP_ADMIN_NAME="Administrateur"
# BOOTSTRAP_ENTREPRISE_NAME="Transport Pro"
# BOOTSTRAP_CONFIRM="yes"